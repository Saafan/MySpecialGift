# Copy to .env and adjust as needed. Values below work with `npm run db:up` out of the box.
# There are no fallback secrets in code: the app fails fast at boot if a required value is missing.

# PostgreSQL (docker-compose publishes 5434 -> 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/mylovelygift?schema=public"

# Where uploaded files are stored in development (served via /api/files/*)
STORAGE_DIR=".data/uploads"

# Optional: enable the Stripe payment provider by setting both keys.
# Without them, checkout uses the built-in, clearly-labelled test payment provider.
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
